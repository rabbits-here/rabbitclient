<?xml version="1.0" encoding="utf-8"?>
<org.levimc.launcher.ui.widget.HomeDashboardLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_rabbit_logo" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:text="@string/rabbit_greeting"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/loader_chip"
                    style="@style/Widget.Levi.Tag.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/pkg_loader_name"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:id="@+id/homeDownloadChip"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />
            <View
                android:id="@+id/homeWorldsChip"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />
            <View
                android:id="@+id/homeResourcePacksChip"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />
            <View
                android:id="@+id/homeSkinPacksChip"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />
            <View
                android:id="@+id/homePkgChip"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />
            <View
                android:id="@+id/homeExternalModsChip"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/main_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/rabbit_hero_background"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:text="@string/rabbit_hero_eyebrow"
                        android:textColor="#D8B4FE"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/minecraft_title_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/misans"
                        android:text="@string/minecraft"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/rabbit_hero_subtitle"
                        android:textColor="#E9D5FF"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/select_version_button"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">
                            <ImageView
                                android:id="@+id/home_instance_icon"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_minecraft_cube" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/rabbit_selected_build"
                                    android:textColor="#C4B5FD"
                                    android:textSize="10sp" />
                                <TextView
                                    android:id="@+id/text_minecraft_version"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_ui_expand_more"
                                app:tint="#E9D5FF" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/home_instance_settings_button"
                            style="@style/Widget.Levi.Button.Icon"
                            android:layout_width="48dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/instance_settings_title"
                            android:backgroundTint="#33FFFFFF"
                            app:icon="@drawable/ic_instance_gears"
                            app:iconSize="20dp"
                            app:iconTint="#FFFFFF"
                            app:strokeWidth="0dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/home_launch_group"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_launch_button"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/launch_button"
                            style="@style/Widget.Levi.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:backgroundTint="@android:color/transparent"
                            android:text="@string/rabbit_launch_now"
                            android:textSize="14sp"
                            app:icon="@drawable/ic_nav_launch"
                            app:iconPadding="8dp"
                            app:iconSize="18dp"
                            app:iconTint="#FFFFFF" />
                        <View
                            android:id="@+id/home_launch_divider"
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:alpha="0.35"
                            android:background="#FFFFFF" />
                        <ImageView
                            android:id="@+id/home_launch_menu_button"
                            android:layout_width="48dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:contentDescription="@string/home_launch_options"
                            android:focusable="true"
                            android:padding="14dp"
                            android:src="@drawable/ic_ui_expand_more"
                            app:tint="#FFFFFF" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/progress_loader"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/Widget.Levi.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_shell_avatar"
                        android:padding="9dp"
                        android:src="@drawable/ic_qa_account" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rabbit_profile_title"
                            android:textAppearance="@style/TextAppearance.Levi.SectionTitle" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/rabbit_profile_subtitle"
                            android:textAppearance="@style/TextAppearance.Levi.Caption" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rabbit_profile_action"
                        android:textColor="@color/accent_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mod_card"
                style="@style/Widget.Levi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_modules"
                            app:tint="@color/accent_text" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/rabbit_modules_title"
                            android:textAppearance="@style/TextAppearance.Levi.SectionTitle" />
                        <TextView
                            android:id="@+id/manage_mods_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp"
                            android:text="@string/home_manage"
                            android:textColor="@color/accent_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <ScrollView
                        android:id="@+id/home_mods_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="10dp"
                        android:scrollbars="none"
                        android:visibility="gone">
                        <LinearLayout
                            android:id="@+id/mods_list_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                    <LinearLayout
                        android:id="@+id/home_mods_empty"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_ui_puzzle"
                            app:tint="@color/ui_muted" />
                        <TextView
                            android:id="@+id/home_mods_empty_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_mods_empty"
                            android:textAppearance="@style/TextAppearance.Levi.Caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/content_mgmt_card"
                style="@style/Widget.Levi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/home_content_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_content"
                            app:tint="@color/accent_text" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/content_mgmt_section_title"
                            android:textAppearance="@style/TextAppearance.Levi.SectionTitle" />
                        <TextView
                            android:id="@+id/content_view_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp"
                            android:text="@string/home_view_all"
                            android:textColor="@color/accent_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/home_content_chip"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/content_worlds_row"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">
                            <ImageView
                                android:id="@+id/home_worlds_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_ui_globe"
                                app:tint="@color/ui_muted" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/worlds_category"
                                android:textAppearance="@style/TextAppearance.Levi.Body" />
                            <TextView
                                android:id="@+id/content_worlds_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/accent_text"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/content_resource_packs_row"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">
                            <ImageView
                                android:id="@+id/home_resource_packs_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_ui_image"
                                app:tint="@color/ui_muted" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/resource_packs_category"
                                android:textAppearance="@style/TextAppearance.Levi.Body" />
                            <TextView
                                android:id="@+id/content_resource_packs_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/accent_text"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/content_skin_packs_row"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">
                            <ImageView
                                android:id="@+id/home_skin_packs_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_tshirt"
                                app:tint="@color/ui_muted" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/skin_packs_category"
                                android:textAppearance="@style/TextAppearance.Levi.Body" />
                            <TextView
                                android:id="@+id/content_skin_packs_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/accent_text"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/misc_card"
                style="@style/Widget.Levi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/home_download_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_ui_cloud_download"
                            app:tint="@color/accent_text" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/rabbit_tools_title"
                            android:textAppearance="@style/TextAppearance.Levi.SectionTitle" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/misc_curseforge_row"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">
                            <ImageView
                                android:id="@+id/home_curseforge_chip"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_qa_curseforge" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/curseforge_title"
                                android:textAppearance="@style/TextAppearance.Levi.Body" />
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_ui_chevron_right"
                                app:tint="@color/ui_muted" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/misc_pkg_row"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">
                            <ImageView
                                android:id="@+id/home_pkg_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_modules"
                                app:tint="@color/ui_muted" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/rabbit_modules_title"
                                android:textAppearance="@style/TextAppearance.Levi.Body" />
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_ui_chevron_right"
                                app:tint="@color/ui_muted" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/misc_external_mods_row"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_ui_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">
                            <ImageView
                                android:id="@+id/home_external_mods_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_plugin"
                                app:tint="@color/ui_muted" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/external_mods"
                                android:textAppearance="@style/TextAppearance.Levi.Body" />
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_ui_chevron_right"
                                app:tint="@color/ui_muted" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tip_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</org.levimc.launcher.ui.widget.HomeDashboardLayout>
