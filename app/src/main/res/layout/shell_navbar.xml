<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="horizontal"
    android:tag="levi_keep_background">

    <org.levimc.launcher.ui.widget.CenteredNavbarLayout
        android:id="@+id/nav_bar_root"
        android:layout_width="68dp"
        android:layout_height="match_parent"
        android:background="@color/ui_chrome"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:tag="levi_keep_background">

        <ImageView
            android:id="@+id/nav_back_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:padding="8dp"
            android:src="@drawable/ic_ui_arrow_back"
            android:tooltipText="@string/nav_back"
            app:tint="@color/ui_muted" />

        <ImageView
            android:id="@+id/nav_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_rabbit_logo" />

        <TextView
            android:id="@+id/nav_app_name"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:contentDescription="@string/app_name"
            android:text="@string/app_name"
            android:textSize="1sp"
            android:visibility="invisible" />

        <View
            android:id="@+id/nav_divider"
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/nav_navbar_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/nav_tab_launch"
                style="@style/Widget.Levi.NavbarItem"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_nav_launch"
                android:drawablePadding="0dp"
                android:padding="0dp"
                android:text=""
                android:tooltipText="@string/nav_launch" />
            <TextView
                android:id="@+id/nav_tab_download"
                style="@style/Widget.Levi.NavbarItem"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_nav_download"
                android:drawablePadding="0dp"
                android:padding="0dp"
                android:text=""
                android:tooltipText="@string/nav_download" />
            <TextView
                android:id="@+id/nav_tab_instances"
                style="@style/Widget.Levi.NavbarItem"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_nav_instances"
                android:drawablePadding="0dp"
                android:padding="0dp"
                android:text=""
                android:tooltipText="@string/nav_instances" />
            <TextView
                android:id="@+id/nav_tab_about"
                style="@style/Widget.Levi.NavbarItem"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_nav_about"
                android:drawablePadding="0dp"
                android:padding="0dp"
                android:text=""
                android:tooltipText="@string/nav_about" />
            <TextView
                android:id="@+id/nav_tab_settings"
                style="@style/Widget.Levi.NavbarItem"
                android:layout_width="56dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_nav_settings"
                android:drawablePadding="0dp"
                android:padding="0dp"
                android:text=""
                android:tooltipText="@string/nav_settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/nav_theme_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_toggle_theme"
                android:padding="9dp"
                android:src="@drawable/ic_sun"
                android:tooltipText="@string/nav_toggle_theme"
                app:tint="@color/ui_muted" />
            <include layout="@layout/shell_account_cluster" />
        </LinearLayout>
    </org.levimc.launcher.ui.widget.CenteredNavbarLayout>

    <FrameLayout
        android:id="@+id/shell_content"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
